/* General QMainWindow styling */
QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
}

/* Menu bar styling */
QMenuBar {
    background-color: #353535;
    color: #ffffff;
    font-size: 14px;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    margin: 0 2px;
}

QMenuBar::item:selected {
    background-color: #4a4a4a;
    border-radius: 4px;
}

QMenu {
    background-color: #353535;
    border: 1px solid #4a4a4a;
    padding: 4px;
    color: #ffffff;
}

QMenu::item {
    padding: 4px 24px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #4a4a4a;
    color: #ffffff;
    border-radius: 4px;
}

/* Toolbar styling */
QToolBar {
    background-color: #353535;
    border: none;
    padding: 4px;
}

QToolBar::separator {
    background-color: #4a4a4a;
    width: 1px;
    margin: 4px;
}

QToolBar QToolButton {
    background-color: transparent;
    padding: 6px;
    margin: 2px;
    border: none;
    color: #ffffff;
}

QToolBar QToolButton:hover {
    background-color: #4a4a4a;
    border-radius: 4px;
}

QToolBar QToolButton:pressed {
    background-color: #5e5e5e;
}

/* Dock widget styling */
QDockWidget {
    border: 1px solid #4a4a4a;
    background-color: #2b2b2b;
    color: #ffffff;
}

QDockWidget::title {
    background-color: #353535;
    padding: 6px;
    border-bottom: 1px solid #4a4a4a;
    text-align: left;
    font-weight: bold;
}

QDockWidget::close-button {
    background-color: transparent;
    border: none;
    padding: 4px;
    icon-size: 16px;
}

QDockWidget::close-button:hover {
    background-color: #4a4a4a;
    border-radius: 4px;
}

QDockWidget::close-button:pressed {
    background-color: #5e5e5e;
}

/* Central widget (SceneViewWidget) */
SceneViewWidget {
    background-color: #1e1e1e;
    border: 1px solid #4a4a4a;
}

/* PropertyEditorWidget */
PropertyEditorWidget {
    background-color: #2b2b2b;
    border: 1px solid #4a4a4a;
}

PropertyEditorWidget QWidget {
    background-color: transparent;
    color: #ffffff;
}

/* AssetsBrowserWidget */
AssetsBrowserWidget {
    background-color: #2b2b2b;
    border: 1px solid #4a4a4a;
}

AssetsBrowserWidget QTreeView, AssetsBrowserWidget QListView {
    background-color: #2b2b2b;
    color: #ffffff;
    border: none;
    selection-background-color: #4a4a4a;
    selection-color: #ffffff;
}

/* Console output (QTextEdit) */
QTextEdit {
    background-color: #1e1e1e;
    color: #ffffff;
    border: 1px solid #4a4a4a;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 8px;
}

/* Status bar styling */
QStatusBar {
    background-color: #353535;
    color: #ffffff;
    border-top: 1px solid #4a4a4a;
}

/* Scroll bars */
QScrollBar:vertical {
    background: #353535;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #4a4a4a;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: #353535;
    height: 0px;
}

QScrollBar:horizontal {
    background: #353535;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #4a4a4a;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: #353535;
    width: 0px;
}

/* Tooltips */
QToolTip {
    background-color: #353535;
    color: #ffffff;
    border: 1px solid #4a4a4a;
    padding: 4px;
}

/* QAction hover effect (for buttons in toolbars) */
QAction:hover {
    background-color: #4a4a4a;
}

/* Disabled widgets */
QWidget:disabled {
    color: #666666;
}